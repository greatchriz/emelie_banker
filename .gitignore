# Project-specific ignore rules for this Laravel shared-hosting layout.
#
# Keep deployment entry files trackable:
#   /.htaccess, /index.php, /robots.txt, /web.config, /assets/
# Keep install/build manifests trackable:
#   project/composer.json, project/composer.lock, project/package.json,
#   project/webpack.mix.js, project/.env.example

# Local environment and secrets
.env
.env.*
!.env.example
project/.env
project/.env.*
!project/.env.example
*.key
project/storage/*.key

# PHP dependencies
vendor/
project/vendor/

# Node dependencies and build temp files
node_modules/
project/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Laravel runtime files
project/bootstrap/cache/*.php
project/storage/app/*
!project/storage/app/.gitignore
!project/storage/app/public/
project/storage/app/public/*
!project/storage/app/public/.gitignore
project/storage/framework/cache/*
!project/storage/framework/cache/.gitignore
project/storage/framework/cache/data/*
!project/storage/framework/cache/data/.gitignore
project/storage/framework/sessions/*
!project/storage/framework/sessions/.gitignore
project/storage/framework/testing/*
!project/storage/framework/testing/.gitignore
project/storage/framework/views/*
!project/storage/framework/views/.gitignore
project/storage/logs/*
!project/storage/logs/.gitignore

# Laravel public runtime symlinks / hot reload files
project/public/hot
project/public/storage
public/hot
public/storage

# Test and coverage output
.phpunit.result.cache
project/.phpunit.result.cache
coverage/
project/coverage/
TEST*.xml

# Local editor and OS files
.idea/
.vscode/
.history/
*.code-workspace
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp
*.swp
*.swo
*.bak
*.backup
backup.txt
rooted.txt

# Local Docker / VM overrides
docker-compose.override.yml
Homestead.json
Homestead.yaml

# Local mirrored template/reference dump; copied runtime assets live in /assets/user/bankhub/
ewbcreditbankhub/

# Compiled or packaged artifacts outside public runtime asset folders
/dist/
/build/
/target/
project/dist/
project/build/
project/target/
*.class
*.jar
*.war
*.app
*.exe

# Large local media exports
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv
project.zip
ewbckmdb_ewbcredit (1).sql
